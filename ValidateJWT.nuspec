<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ValidateJWT</id>
    <version>1.6.0</version>
    <authors>Johan Henningsson</authors>
    <owners>Johan Henningsson</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE.txt</license>
    <projectUrl>https://github.com/johanhenningsson4-hash/ValidateJWT</projectUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <description>Complete JWT library for .NET Framework 4.7.2 with generation, validation, claim extraction, signature verification (HS256, RS256), and proactive token renewal. Create and validate JWTs with comprehensive claim support and automatic token renewal before expiration. No dependencies. Well-tested, production-ready, and CI/CD enabled.</description>
    <releaseNotes>v1.6.0 - Adds proactive JWT token renewal: ShouldRenewToken() and GetTimeUntilRenewal() methods to automatically renew tokens X minutes before expiration. Prevents token expiration issues with configurable renewal windows. Includes 20 new unit tests and comprehensive documentation.</releaseNotes>
    <copyright>Copyright © Johan Henningsson 2026</copyright>
    <tags>jwt jsonwebtoken token validation security dotnet net472 issuer audience claims nbf iat renewal refresh expiration</tags>
    <repository type="git" url="https://github.com/johanhenningsson4-hash/ValidateJWT" />
    <dependencies>
      <group targetFramework=".NETFramework4.7.2" />
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\Johan.Common.ValidateJWT.dll" target="lib\net472\" />
    <file src="bin\Release\Johan.Common.ValidateJWT.xml" target="lib\net472\" />
    <file src="LICENSE.txt" target="" />
    <file src="README.md" target="" />
    <file src="icon.png" target="" />
  </files>
</package>
